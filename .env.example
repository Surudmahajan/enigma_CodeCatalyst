# ---------------------------------------------------------------------------
# SYMBIO environment configuration
# Copy to `.env` (root, used by docker-compose) or `apps/backend/.env`.
# NEVER commit real secrets. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# PostgreSQL in docker-compose / production. SQLite works for local dev/tests:
#   DATABASE_URL=sqlite:///./var/symbio.db
DATABASE_URL=postgresql+psycopg://symbio:symbio@localhost:5432/symbio
POSTGRES_USER=symbio
POSTGRES_PASSWORD=symbio
POSTGRES_DB=symbio

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Redis (optional in dev; used for rate limiting / realtime fan-out when set)
REDIS_URL=redis://localhost:6379/0

# Object storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_BUCKET=symbio-documents
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_MB=15

# AI — none | anthropic. The platform works fully without an AI provider;
# deterministic matching never depends on it.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Embeddings — local (deterministic hashing embeddings) | openai_compatible
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_MODEL=
# Reserved for an external vector store; MVP keeps vectors in PostgreSQL.
VECTOR_DATABASE_URL=

# Email — console (logs emails) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@symbio.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Push notifications — none | expo
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=

# Comma-separated origins allowed by CORS (admin console, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Background jobs — thread (in-process worker pool) | eager (run inline, tests)
JOBS_MODE=thread
RATE_LIMIT_ENABLED=true

# Password used by `python -m app.seed` for demo accounts (dev only)
SEED_DEMO_PASSWORD=Symbio-Demo-2026!

# Mobile app (Expo) — backend base URL reachable from the device/emulator.
# Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
